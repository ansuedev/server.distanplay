# Copy to .env for local runs (docker compose up -d starts Postgres on 55432).
DATABASE_URL=postgres://distanplay:distanplay@localhost:55432/distanplay
PORT=8787
# Public base URL (Railway: https://<your-service>.up.railway.app or your domain).
PUBLIC_URL=http://localhost:8787

# Discord app (https://discord.com/developers/applications → OAuth2).
# Add the redirect: <PUBLIC_URL>/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (Ed25519 seed for connection tickets — keep it stable)
TICKET_SIGNING_KEY=

# Optional
# STUN_SERVERS=stun.l.google.com:19302,stun.cloudflare.com:3478
# UDP_RELAY=relay.example.com:3478   (Railway has no public UDP; host one elsewhere)
# WS_RELAY=true                      (relay over the WebSocket as the last resort)
# ADMIN_ORIGIN=https://admin.example.com
# DEV_LOGIN=1                        (debug builds only: /v1/auth/dev, no Discord)
# RUST_LOG=info,distanplay_server=debug
